{
  "name": "ai27-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "sim": "tsx scripts/simtest.ts",
    "shots": "node scripts/shot.mjs",
    "test:effects": "tsx scripts/controltest.ts",
    "test:ui": "vite build && node scripts/uitest.mjs",
    "test:v2": "tsc --noEmit -p scripts/v2/tsconfig.json && tsx scripts/v2/golden-timelines.ts && tsx scripts/v2/identity.ts && tsx scripts/v2/calib.ts && tsx scripts/v2/fixtures.ts && tsx scripts/v2/hygiene.ts && tsx scripts/v2/lint-hidden.ts && tsx scripts/v2/lint-tradeoffs.ts && tsx scripts/v2/safety.ts && tsx scripts/v2/finance.ts",
    "fixtures:v2": "tsx scripts/v2/fixtures.ts",
    "dev:v2": "vite --open /?v2"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
