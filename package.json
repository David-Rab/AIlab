{
  "name": "ai27-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "registry:lint": "tsx scripts/v2/registry-lint.ts",
    "scenarios:lint": "tsx scripts/v2/scenarios-lint.ts",
    "bal:run": "tsx scripts/v2/balrun.ts",
    "bal:dash": "tsx scripts/v2/baldash.ts",
    "test:ui": "npm run build && node scripts/v2/uitest.mjs",
    "test:quick": "tsx scripts/v2/run.ts --tier quick",
    "test:cal": "tsx scripts/v2/run.ts --tier cal",
    "test:full": "tsx scripts/v2/run.ts --tier full",
    "test:deep": "tsx scripts/v2/run.ts --tier deep",
    "test:perf": "tsx scripts/v2/run.ts --tier perf",
    "test:v2": "npm run test:full",
    "test:worldfx": "tsx scripts/v2/worldfx.ts",
    "bots:v2": "tsx scripts/v2/bots.ts",
    "fixtures:v2": "tsx scripts/v2/fixtures.ts --write",
    "test": "npm run test:v2"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
