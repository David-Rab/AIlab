 "responseInfo": {
  "patchSignal": {
   "title": "Harden environments",
   "note": "Harden the post-training environments of one family (the Harden pass of Training › Environments): expert red-teamers close the loopholes in its graders, cutting them by 40% of what is left above the floor (10% of the family’s start) on every later run that trains on it. Costs cash and engineer time; in force when the pass is done."
  },
  "addMethod": {
   "title": "Add method to later runs",
   "note": "Every later run plan that takes the default methods lists this owned safety method (persona vectors, anti-scheming, inoculation…); its effect shows in the next run's predicted traits, not in this model."
  },
  "restrictContext": {
   "title": "Restrict context",
   "note": "Restricted products: usage, revenue, misuse reach and incident opportunity × 0.3."
  },
  "liftRestriction": {
   "title": "Lift restriction",
   "note": "Remove the restriction safeguard: usage, revenue, misuse reach and incident opportunity back to full."
  },
  "addControl": {
   "title": "Add control protocol",
   "note": "Control-protocol safeguard (trusted monitoring, the most suspicious 10% deferred to a trusted model): about 7% slowdown at a typical watcher gap; acts slipping past monitors ×0.45; risky actions blocked."
  },
  "removeControl": {
   "title": "Remove control protocol",
   "note": "Remove the control-protocol safeguard: its slowdown ends; blocking and deferral end with it."
  },
  "addLockdown": {
   "title": "Add comms lockdown",
   "note": "Comms-lockdown safeguard on the model's AI staff (shared memory locked): copies of one model cover for each other half as much; 3% slowdown of AI staff work."
  },
  "removeLockdown": {
   "title": "Remove comms lockdown",
